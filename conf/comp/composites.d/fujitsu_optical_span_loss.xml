<?xml version="1.0" encoding="UTF-8" ?>

<composite>
    <variables>
        <scan value="none" oid="1.3.6.1.4.1.211.1.24.12.800.8.1.3.1.*.1.*.1.*.2.*.*">
            <match name="shelf"/>
            <match name="slot"/>
            <match name="subslot"/>
            <match name="port"/>
            <match name="port2"/>
        </scan>
    </variables>

    <data>
        <meta name="intf" source="shelf" />
        <meta name="shelf" source="shelf" />
        <meta name="slot" source="slot" />
        <meta name="subslot" source="subslot" />
        <meta name="port" source="port" />
        <meta name="port2" source="port2" />
        <value name="span_loss" source="1.3.6.1.4.1.211.1.24.12.800.8.1.3.1.shelf.1.slot.1.snubslot.2.port.port2.527.0.1.2.0" />
    </data>

    <conversions>
        <replace this='(\d+)' with='sub {return chr($_[1]);}'>
            <data name="shelf" />
            <data name="slot" />
            <data name="subslot" />
            <data name="port" />
        </replace>

        <replace this='${}' with='Shelf ${shelf} - Slot ${slot}.${subslot} - Port ${port}'>
            <data name="intf" />
        </replace>

        <drop>
            <data name="shelf" />
            <data name="slot" />
            <data name="subslot" />
            <data name="port" />
            <data name="port2" />
        </drop>
    </conversions>
</composite>