<?xml version="1.0" encoding="UTF-8" ?>

<composite>
    <variables>
        <scan value="intf_name" oid="1.3.6.1.4.1.1271.2.1.1.1.1.1.1.7.*">
            <match name="id"/>
        </scan>
    </variables>

    <data>
        <meta name="intf" source="intf_name" />
        <value name="status" source="1.3.6.1.4.1.1271.2.1.1.1.3.1.1.2.id" />
    </data>

    <conversions>
        <function definition='2 ne 0 ${} ifelse'>
            <data name="status" />
        </function>

        <function definition='2 eq 1 ${} ifelse'>
            <data name="status" />
        </function>
    </conversions>
</composite>